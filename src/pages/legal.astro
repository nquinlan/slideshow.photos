---
/**
 * Privacy policy and terms of service. Static, like the landing page, and reuses its styles.
 * #privacy and #terms are linkable on their own (e.g. from Google's OAuth consent screen).
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import landingCss from '../styles/landing.css?inline';

const updated = 'October 5, 2026';
const contact = 'nick@nicholasquinlan.com';
const title = `Privacy Policy & Terms of Service — ${SITE.name}`;
const description = `How ${SITE.name} handles your data (it doesn't collect any) and the terms for using it.`;
---

<Base title={title} description={description} path="/legal">
  <style slot="head" is:inline set:html={landingCss} />

  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="/" aria-label={`${SITE.name} home`}>
        <img src="/favicon.svg" alt="" width="28" height="28" />
        <span>{SITE.name}</span>
      </a>
      <a class="btn btn-primary btn-sm" href={SITE.appPath}>Launch app</a>
    </div>
  </header>

  <main id="main" tabindex="-1" class="legal">
    <div class="wrap">
      <section id="privacy" aria-labelledby="privacy-title">
        <h1 id="privacy-title">Privacy Policy</h1>
        <p class="updated">Last updated {updated}</p>
        <p class="lede">
          {SITE.name} doesn’t collect, store or sell your personal information. Your photos stay on your device. (Our
          hosting providers see basic technical data, described below.)
        </p>

        <h2>Your photos</h2>
        <p>
          Photos you add are processed and stored in your browser, on your own device, using your browser’s local storage
          (such as IndexedDB). They are never uploaded to us. Deleting a collection, or clearing this site’s data in your
          browser, removes them. Backups you export are files you keep.
        </p>

        <h2>Google Photos</h2>
        <p>
          If you import from Google Photos, you sign in with Google and grant read-only access
          (<code>photospicker.mediaitems.readonly</code>) to the photos you pick, and nothing else. Sign-in is run by
          Google and is subject to <a href="https://policies.google.com/privacy" rel="noopener">Google’s Privacy Policy</a
          >. The photos you pick download straight from Google to your browser. The access token is kept in memory only
          and expires after about an hour. We never receive, store or share your Google data. You can remove access
          anytime in your <a href="https://myaccount.google.com/permissions" rel="noopener">Google Account settings</a>.
        </p>
        <p>
          {SITE.name}’s use and transfer to any other app of information received from Google APIs will adhere to the
          <a href="https://developers.google.com/terms/api-services-user-data-policy" rel="noopener"
            >Google API Services User Data Policy</a
          >, including the Limited Use requirements. We don’t use Google data for advertising, don’t allow humans to read
          it, and don’t use it to train AI or machine learning models.
        </p>

        <h2>Hosting</h2>
        <p>
          This site is hosted on GitHub Pages and delivered through Cloudflare’s network. Like any website, they process
          basic technical information, such as your IP address, browser type and the pages requested, to deliver the site
          and protect it from abuse. Cloudflare may set strictly necessary security cookies. See
          <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener"
            >GitHub’s privacy statement</a
          > and <a href="https://www.cloudflare.com/privacypolicy/" rel="noopener">Cloudflare’s privacy policy</a>. We
          don’t use this information to identify or track you.
        </p>

        <h2>Third-party resources</h2>
        <p>
          When you import from Google Photos, the site loads Google’s sign-in script (Google Identity Services) from
          Google. When your browser requests it, Google receives basic technical information, such as your IP address
          and browser type, and handles it under its own privacy policy. We don’t receive this information or use it to
          identify or track you.
        </p>

        <h2>No tracking</h2>
        <p>
          There are no accounts, analytics, advertising or tracking cookies. If that ever changes, we’ll update this
          policy first.
        </p>

        <h2>Children</h2>
        <p>{SITE.name} isn’t directed to children under 13, and we don’t knowingly collect their information.</p>

        <h2>Changes</h2>
        <p>If this policy changes, we’ll update this page and the date above.</p>

        <h2>Contact</h2>
        <p>
          {SITE.name} is operated by Nicholas Quinlan. Questions about privacy? Email
          <a href={`mailto:${contact}`}>{contact}</a>.
        </p>
        <p>See also our <a href="#terms">Terms of Service</a>.</p>
      </section>

      <section id="terms" aria-labelledby="terms-title">
        <h1 id="terms-title">Terms of Service</h1>
        <p class="updated">Last updated {updated}</p>
        <p class="lede">By using {SITE.name}, you agree to these terms and our <a href="#privacy">Privacy Policy</a>.</p>

        <h2>Using {SITE.name}</h2>
        <p>
          {SITE.name} is free to use, including for personal or commercial slideshows. Only add photos you have the right
          to use. They remain yours, and we get no rights to them.
        </p>
        <p>
          Don’t use {SITE.name} for anything illegal, including showing content that is unlawful or that infringes
          someone else’s rights, and don’t try to disrupt or misuse the site. We may suspend or block access to anyone
          who does.
        </p>

        <h2>Open source</h2>
        <p>
          The {SITE.name} source code is released under the
          <a href="https://opensource.org/license/mit" rel="noopener">MIT License</a>. That license governs the code.
          These terms govern your use of the hosted site at {SITE.name}. The {SITE.name} name isn’t licensed under the
          MIT License.
        </p>

        <h2>Your data</h2>
        <p>
          Your library lives in your browser, and browsers can clear stored data. Keep your originals, and export a
          backup if your slideshows matter to you.
        </p>

        <h2>Third-party services</h2>
        <p>
          Importing from Google Photos is also subject to
          <a href="https://policies.google.com/terms" rel="noopener">Google’s terms</a>. Google Photos and our hosting
          providers are third-party services we don’t control, and we aren’t responsible for them.
        </p>

        <h2>No warranty</h2>
        <p>
          {SITE.name} is provided “as is”, without warranties of any kind. To the fullest extent permitted by law, we
          aren’t liable for any indirect, incidental or consequential damages, or for any loss of photos or data, arising
          from your use of {SITE.name}. Some jurisdictions don’t allow certain exclusions, so parts of this may not apply
          to you.
        </p>

        <h2>Governing law</h2>
        <p>
          These terms are governed by the laws of the State of Washington, USA, and disputes will be handled in the state
          or federal courts located in King County, Washington.
        </p>

        <h2>Changes</h2>
        <p>
          We may change or discontinue {SITE.name}, or update these terms, at any time. Continuing to use it means you
          accept the current terms. If any part of these terms is unenforceable, the rest still applies.
        </p>

        <h2>Contact</h2>
        <p>Questions about these terms? Email <a href={`mailto:${contact}`}>{contact}</a>.</p>
      </section>
    </div>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <p>{SITE.name} — free to use. Your photos stay on your device.</p>
      <nav aria-label="Footer">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href={SITE.appPath}>Launch app</a></li>
        </ul>
      </nav>
    </div>
  </footer>
</Base>

<style>
  .legal section {
    max-width: 44rem;
  }

  .legal h1 {
    font-size: clamp(1.8rem, 1.3rem + 2vw, 2.6rem);
    margin-bottom: 0.25em;
  }

  .legal h2 {
    font-size: 1.2rem;
    margin-top: 1.75em;
  }

  .legal p {
    color: var(--muted);
  }

  .legal .updated {
    font-size: 0.95rem;
  }
</style>
