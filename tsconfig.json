{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@app/*": ["src/app/*"] }
  },
  "include": ["src", "tests", "bench", "*.ts", "*.mjs"],
  "exclude": ["dist", "node_modules", ".playwright-browsers"]
}
