# Copy to .env.local (gitignored). Only PUBLIC_ values: these are embedded in the static build.
# OAuth 2.0 *Web application* client id. Never put a client secret in this app.
PUBLIC_GOOGLE_CLIENT_ID=
# How picked photos are downloaded: header (documented) | query (see spike/README.md)
PUBLIC_GOOGLE_MEDIA_FETCH=header
# Canonical origin for canonical/OG URLs and sitemap.xml (build time)
SITE_URL=https://tessera-slideshow.example
